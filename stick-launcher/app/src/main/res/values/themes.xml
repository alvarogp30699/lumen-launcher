<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fondo oscuro desde el primer fotograma: sin destello al abrir y sin pintar el fondo dos veces -->
    <style name="Lumen" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/lumen_bg</item>
        <item name="android:colorBackground">@color/lumen_bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/LumenFade</item>
    </style>
    <!-- Reproductor: negro puro -->
    <style name="Lumen.Player">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <!-- Inicio: logo de Lumen mientras arranca -->
    <style name="Lumen.Splash">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
    <!-- Fundido corto al cambiar de pantalla -->
    <style name="LumenFade" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/lumen_in</item>
        <item name="android:activityOpenExitAnimation">@anim/lumen_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/lumen_in</item>
        <item name="android:activityCloseExitAnimation">@anim/lumen_out</item>
    </style>
    <color name="lumen_bg">#0B0D12</color>
</resources>
